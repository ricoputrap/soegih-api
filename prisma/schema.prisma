generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  expense
  income
}

enum WalletType {
  cash
  bank
  e_wallet
  other
}

enum TransactionType {
  expense
  income
  transfer
}

model Category {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        CategoryType
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  deleted_at  DateTime?

  events TransactionEvent[]

  @@unique([name, type])
  @@map("categories")
}

model Wallet {
  id         String     @id @default(cuid())
  name       String     @unique
  type       WalletType
  currency   String     @default("IDR")
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  deleted_at DateTime?

  postings Posting[]

  @@map("wallets")
}

model TransactionEvent {
  id          String          @id @default(cuid())
  occurred_at DateTime
  type        TransactionType
  note        String?
  payee       String?
  category_id String?
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  deleted_at  DateTime?

  category Category? @relation(fields: [category_id], references: [id])
  postings Posting[]

  @@map("transaction_events")
}

model Posting {
  id         String   @id @default(cuid())
  event_id   String
  wallet_id  String
  amount     Int
  created_at DateTime @default(now())
  deleted_at DateTime?

  event  TransactionEvent @relation(fields: [event_id], references: [id])
  wallet Wallet           @relation(fields: [wallet_id], references: [id])

  @@map("postings")
}
