generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  income
  expense
}

enum WalletType {
  cash
  bank
  e_wallet
  other
}

enum TransactionType {
  income
  expense
  transfer
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  categories   Category[]
  wallets      Wallet[]
  transactions TransactionEvent[]

  @@map("users")
}

model Category {
  id          String       @id @default(cuid())
  user_id     String
  name        String
  description String?
  type        CategoryType
  deleted_at  DateTime?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  user         User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions TransactionEvent[]

  @@unique([user_id, name, type])
  @@index([user_id])
  @@index([deleted_at])
  @@map("categories")
}

model Wallet {
  id         String     @id @default(cuid())
  user_id    String
  name       String
  type       WalletType
  currency   String     @default("IDR")
  deleted_at DateTime?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  postings Posting[]

  @@unique([user_id, name])
  @@index([user_id])
  @@index([deleted_at])
  @@map("wallets")
}

model TransactionEvent {
  id          String          @id @default(cuid())
  user_id     String
  type        TransactionType
  occurred_at DateTime
  note        String?
  payee       String?
  category_id String?
  deleted_at  DateTime?
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [category_id], references: [id])
  postings   Posting[]

  @@index([user_id])
  @@index([category_id])
  @@index([occurred_at])
  @@index([deleted_at])
  @@map("transaction_events")
}

model Posting {
  id         String   @id @default(cuid())
  event_id   String
  wallet_id  String
  amount     Int
  created_at DateTime @default(now())
  deleted_at DateTime?

  event  TransactionEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  wallet Wallet           @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@index([wallet_id])
  @@index([deleted_at])
  @@map("postings")
}
